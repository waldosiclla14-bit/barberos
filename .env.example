# BARBEROS — Variables de entorno
# Nunca subir secretos reales a control de versiones.

# Base de datos.
# Desarrollo local (SQLite):
DATABASE_URL="file:./dev.db"
#
# Producción (PostgreSQL): descomenta y ajusta. El adapter se elige solo
# según el prefijo; luego regenera el schema PG y crea el esquema:
#   npx tsx scripts/prepare-pg.ts          # genera prisma/schema.pg.prisma
#   npx prisma db push --config prisma.config.pg.ts
#   npm run db:seed                        # datos demo (opcional)
# DATABASE_URL="postgresql://usuario:password@host:5432/barberos"

# Secreto para firmar tokens internos (generar con: openssl rand -base64 32)
AUTH_SECRET=

# Feature flags — el sistema funciona sin estas integraciones (seccion 113)
WHATSAPP_ENABLED=false
AI_ENABLED=false
PAYMENTS_ENABLED=false
MARKETPLACE_ENABLED=false

# Integraciones externas (dejar vacías hasta contratar proveedor)
WHATSAPP_API_KEY=
# Webhook del proveedor de WhatsApp. Si WHATSAPP_ENABLED=true y esto está
# definido, confirmaciones y recordatorios se POSTean aquí (JSON:
# { channel, kind, to, body }) en lugar de solo registrarse en MessageLog.
WHATSAPP_WEBHOOK_URL=
# Secreto para el endpoint del scheduler externo /api/reminders/run.
# Invocar con: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
PAYMENT_API_KEY=
EMAIL_API_KEY=
AI_API_KEY=